      "seed": 56511,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793579992993,
      "link": null,
      "locked": false,
      "text": "FastAPI HTTP Layer (api.py + schemas.py)\nValidates JSON Request/Response via Pydantic Models\n\u2022 POST /api/v1/users                        -> Create user\n\u2022 POST /api/v1/accounts                     -> Connect bank & sync transactions\n\u2022 POST /api/v1/accounts/{id}/sync           -> Re-sync transactions\n\u2022 GET  /api/v1/users/{id}/transactions      -> List user transactions\n\u2022 PATCH /api/v1/transactions/{id}/category  -> Override transaction category\n\u2022 POST /api/v1/budgets                      -> Upsert monthly budget\n\u2022 GET  /api/v1/users/{id}/spending          -> Monthly spending & budget alerts",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "FastAPI HTTP Layer (api.py + schemas.py)\nValidates JSON Request/Response via Pydantic Models\n\u2022 POST /api/v1/users                        -> Create user\n\u2022 POST /api/v1/accounts                     -> Connect bank & sync transactions\n\u2022 POST /api/v1/accounts/{id}/sync           -> Re-sync transactions\n\u2022 GET  /api/v1/users/{id}/transactions      -> List user transactions\n\u2022 PATCH /api/v1/transactions/{id}/category  -> Override transaction category\n\u2022 POST /api/v1/budgets                      -> Upsert monthly budget\n\u2022 GET  /api/v1/users/{id}/spending          -> Monthly spending & budget alerts",
      "lineHeight": 1.25
    },
