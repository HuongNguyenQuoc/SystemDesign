    {
      "id": "t_api",
      "type": "text",
      "x": 140,
      "y": 205,
      "width": 595.66,
      "height": 152.10000000000002,
      "angle": 0,
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
